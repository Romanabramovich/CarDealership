<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Car</title>
    <link rel="stylesheet" href="/styles/styles.css">
</head>

<body>
    <header>
        <a href="/">Back to Home</a>
        <h1>Edit Car</h1>
    </header>

    <% if (successMessage) { %>
        <div class="success">
            <p>
                <%= successMessage %>
            </p>
        </div>
        <% } %>

            <% if (errorMessage) { %>
                <div class="error">
                    <p>
                        <%= errorMessage %>
                    </p>
                </div>
                <% } %>

                    <form action="/edit-car/<%= car._id %>" method="POST">
                        <label for="make">Make:</label>
                        <input type="text" id="make" name="make" value="<%= car.make %>" required><br>

                        <label for="model">Model:</label>
                        <input type="text" id="model" name="model" value="<%= car.model %>" required><br>

                        <label for="price">Price:</label>
                        <input type="number" id="price" name="price" value="<%= car.price %>" required><br>

                        <label for="year">Year:</label>
                        <input type="number" id="year" name="launch_year" value="<%= car.launch_year %>" required><br>


                        <button type="submit">Save Changes</button>
                    </form>
</body>

</html>